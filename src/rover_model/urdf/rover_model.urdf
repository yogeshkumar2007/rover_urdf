    <!--
      Navigation frame convention:
      base_footprint is the root reference frame and base_link is its child.
      The transform is identity because the measured vertical distance from
      the footprint plane to the CAD base_link origin was not supplied.
      Set origin xyz="0 0 Z" only after measuring that offset in CAD.
      Nav2 can use base_link as robot_base_frame until that measurement is known.
    -->
    <link name="base_footprint" />
    <joint name="base_footprint_to_base_link" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_footprint" />
        <child link="base_link" />
    </joint>
</robot>